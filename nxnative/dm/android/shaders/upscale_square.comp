#version 450
// Spatial replacement for an explicitly audited sqrt-encoded RGB input / linear RGB output.
// Filtering precedes signed-square decoding. No neural residual, sharpening, exposure scale, or HDR clamp.
layout(local_size_x = 16, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D dst;
layout(push_constant) uniform PC { uint w, h; } pc;
void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.w || p.y >= pc.h) return;
    vec2 uv = (vec2(p) + vec2(0.5)) / vec2(pc.w, pc.h);
    vec3 encoded = textureLod(src, uv, 0.0).rgb;
    imageStore(dst, ivec2(p), vec4(encoded * abs(encoded), 1.0));
}
